generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  password               String
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  role                   Role                    @default(USER)
  activities             Activity[]
  companies              Company[]
  contacts               Contact[]
  deals                  Deal[]
  leads                  Lead[]
  notes                  Note[]
  posts                  Post[]
  postRevisions          PostRevision[]
  tasks                  Task[]
  calendarEvents         CalendarEvent[]
  settings               UserSettings?
  notificationPreference NotificationPreference?
  projects               Project[]
  portfolioProjects      PortfolioProject[]
  knowledgeArticles      KnowledgeArticle[]
  financeTransactions    FinanceTransaction[]
  financeImports         FinanceImport[]
  financeAuditLogs       FinanceAuditLog[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  theme            ThemePreference @default(SYSTEM)
  language         String          @default("en")
  timezone         String          @default("Asia/Karachi")
  dateFormat       String          @default("DD/MM/YYYY")
  timeFormat       String          @default("12H")
  sidebarCollapsed Boolean         @default(false)

  emailNotifications    Boolean @default(true)
  taskNotifications     Boolean @default(true)
  crmNotifications      Boolean @default(true)
  calendarNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  emailNotifications  Boolean @default(true)
  taskReminders       Boolean @default(true)
  calendarReminders   Boolean @default(true)
  crmNotifications    Boolean @default(true)
  systemNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String
  featuredImage  String?
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  views          Int        @default(0)
  readingTime    Int        @default(1)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  categoryId     String?
  authorId       String
  deletedAt      DateTime?

  author    User           @relation(fields: [authorId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  revisions PostRevision[]
  tags      Tag[]          @relation("PostToTag")
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  posts       Post[]   @relation("PostToTag")
}

model Folder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media[]

  @@index([name])
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  type         MediaType @default(OTHER)
  size         Int
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  folderId     String?

  folder                Folder?                 @relation(fields: [folderId], references: [id])
  portfolioProjectMedia PortfolioProjectMedia[]

  @@index([deletedAt])
  @@index([type])
  @@index([folderId])
}

model PostRevision {
  id             String     @id @default(cuid())
  postId         String
  title          String
  slug           String
  excerpt        String?
  content        String
  featuredImage  String?
  status         PostStatus
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  readingTime    Int
  categoryId     String?
  authorId       String
  createdAt      DateTime   @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
}

model SEOSettings {
  id                  String   @id @default(cuid())
  siteTitle           String?
  siteDescription     String?
  canonicalUrl        String?
  defaultOgImage      String?
  twitterHandle       String?
  defaultRobotsIndex  Boolean  @default(true)
  defaultRobotsFollow Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SEOPage {
  id            String   @id @default(cuid())
  path          String   @unique
  title         String?
  description   String?
  keywords      String?
  canonical     String?
  noIndex       Boolean  @default(false)
  noFollow      Boolean  @default(false)
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contact {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  jobTitle    String?
  website     String?
  linkedinUrl String?
  description String?
  status      ContactStatus @default(ACTIVE)
  source      LeadSource?
  companyId   String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  activities     Activity[]
  company        Company?        @relation(fields: [companyId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  deals          Deal[]
  leads          Lead[]
  notes          Note[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([companyId])
  @@index([ownerId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model Company {
  id          String        @id @default(cuid())
  name        String
  website     String?
  industry    String?
  size        String?
  phone       String?
  email       String?
  location    String?
  description String?
  status      CompanyStatus @default(ACTIVE)
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  activities          Activity[]
  owner               User                 @relation(fields: [ownerId], references: [id])
  contacts            Contact[]
  deals               Deal[]
  leads               Lead[]
  notes               Note[]
  tasks               Task[]
  calendarEvents      CalendarEvent[]
  projects            Project[]
  financeTransactions FinanceTransaction[]

  @@index([ownerId])
  @@index([status])
  @@index([name])
}

model FinanceCategory {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  type        FinanceCategoryType @default(ALL)
  color       String?
  sortOrder   Int                 @default(0)
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  transactions FinanceTransaction[]

  @@index([type])
  @@index([slug])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([createdAt])
}

model FinanceImport {
  id               String              @id @default(cuid())
  filename         String
  originalFilename String
  fileSize         Int?
  mimeType         String?
  status           FinanceImportStatus @default(UPLOADED)
  sourceHash       String?
  sheetName        String?
  totalRows        Int                 @default(0)
  successfulRows   Int                 @default(0)
  failedRows       Int                 @default(0)
  skippedRows      Int                 @default(0)
  errorSummary     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  createdBy    User                 @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions FinanceTransaction[]

  @@index([createdAt])
  @@index([status])
  @@index([createdById])
  @@index([sourceHash])
}

model FinanceTransaction {
  id               String                 @id @default(cuid())
  type             FinanceTransactionType
  status           FinancePaymentStatus   @default(PENDING)
  reference        String?
  invoiceNumber    String?
  invoiceReference String?
  description      String?
  notes            String?
  amount           Decimal                @db.Decimal(18, 2)
  paidAmount       Decimal                @default(0) @db.Decimal(18, 2)
  pendingAmount    Decimal                @default(0) @db.Decimal(18, 2)
  currency         String                 @default("USD")
  transactionDate  DateTime
  dueDate          DateTime?
  paidAt           DateTime?
  categoryId       String?
  companyId        String?
  createdById      String
  sourceImportId   String?
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  category     FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImport FinanceImport?   @relation(fields: [sourceImportId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([transactionDate])
  @@index([dueDate])
  @@index([paidAt])
  @@index([type])
  @@index([status])
  @@index([categoryId])
  @@index([companyId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([sourceImportId])
  @@index([type, transactionDate])
  @@index([status, pendingAmount])
}

model FinanceAuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  progress    Int             @default(0)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  ownerId   String
  companyId String?

  tasks      Task[]
  activities Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner   User     @relation(fields: [ownerId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([ownerId])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([progress])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
}

model Lead {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      LeadStatus  @default(NEW)
  source      LeadSource?
  value       Decimal?    @db.Decimal(12, 2)
  contactId   String?
  companyId   String?
  ownerId     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  activities     Activity[]
  deal           Deal[]
  company        Company?        @relation(fields: [companyId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  notes          Note[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([contactId])
  @@index([companyId])
  @@index([ownerId])
  @@index([status])
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  description String?
  value       Decimal? @db.Decimal(12, 2)

  contactId  String?
  companyId  String?
  leadId     String?
  pipelineId String
  stageId    String
  ownerId    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  calendarEvents CalendarEvent[]
  company        Company?        @relation(fields: [companyId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  lead           Lead?           @relation(fields: [leadId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  pipeline       Pipeline        @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage   @relation(fields: [stageId], references: [id])
  notes          Note[]
  tasks          Task[]
  activities     Activity[]

  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
}

model Pipeline {
  id          String          @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deals       Deal[]
  stages      PipelineStage[]

  @@index([isDefault])
}

model PipelineStage {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int
  color       String?
  pipelineId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals    Deal[]
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@index([order])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?

  contactId String?
  companyId String?
  leadId    String?
  dealId    String?
  projectId String?

  portfolioProjectId  String?
  portfolioCategoryId String?

  knowledgeArticleId  String?
  knowledgeCategoryId String?

  userId      String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])

  portfolioProject  PortfolioProject?  @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)
  portfolioCategory PortfolioCategory? @relation(fields: [portfolioCategoryId], references: [id], onDelete: Cascade)

  knowledgeArticle  KnowledgeArticle?  @relation(fields: [knowledgeArticleId], references: [id], onDelete: Cascade)
  knowledgeCategory KnowledgeCategory? @relation(fields: [knowledgeCategoryId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([projectId])
  @@index([portfolioProjectId])
  @@index([portfolioCategoryId])
  @@index([knowledgeArticleId])
  @@index([knowledgeCategoryId])
  @@index([userId])
  @@index([type])
  @@index([dueAt])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  contactId String?
  companyId String?
  leadId    String?
  dealId    String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?

  ownerId   String
  contactId String?
  companyId String?
  leadId    String?
  dealId    String?
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project?        @relation(fields: [projectId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  company        Company?        @relation(fields: [companyId], references: [id])
  lead           Lead?           @relation(fields: [leadId], references: [id])
  deal           Deal?           @relation(fields: [dealId], references: [id])
  calendarEvents CalendarEvent[]

  @@index([ownerId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([projectId])
}

model CalendarEvent {
  id          String  @id @default(cuid())
  title       String
  description String?

  type   CalendarEventType   @default(MEETING)
  status CalendarEventStatus @default(SCHEDULED)

  startAt DateTime
  endAt   DateTime
  allDay  Boolean  @default(false)

  location String?

  ownerId String

  contactId String?
  companyId String?
  leadId    String?
  dealId    String?
  taskId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])

  @@index([ownerId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@index([type])
  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([taskId])
}

model PortfolioCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects   PortfolioProject[]
  activities Activity[]

  @@index([name])
  @@index([slug])
  @@index([sortOrder])
  @@index([deletedAt])
}

model PortfolioTechnology {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  projects PortfolioProject[] @relation("PortfolioProjectToTechnology")

  @@index([name])
  @@index([slug])
  @@index([deletedAt])
}

model PortfolioProject {
  id             String                     @id @default(cuid())
  title          String
  slug           String                     @unique
  excerpt        String?
  description    String?
  content        String?
  status         PortfolioProjectStatus     @default(DRAFT)
  visibility     PortfolioProjectVisibility @default(INTERNAL)
  featured       Boolean                    @default(false)
  sortOrder      Int                        @default(0)
  clientName     String?
  clientIndustry String?
  projectUrl     String?
  repositoryUrl  String?
  startDate      DateTime?
  completionDate DateTime?
  categoryId     String?
  authorId       String
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  publishedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  deletedAt      DateTime?

  category     PortfolioCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author       User                    @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  technologies PortfolioTechnology[]   @relation("PortfolioProjectToTechnology")
  media        PortfolioProjectMedia[]
  activities   Activity[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([visibility])
  @@index([featured])
  @@index([sortOrder])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, visibility])
  @@index([deletedAt, updatedAt])
  @@index([categoryId, sortOrder])
  @@index([featured, publishedAt])
}

model PortfolioProjectMedia {
  id        String   @id @default(cuid())
  projectId String
  mediaId   String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  caption   String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media            @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaId])
  @@index([projectId])
  @@index([mediaId])
  @@index([projectId, sortOrder])
  @@index([isPrimary])
}

model KnowledgeCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles   KnowledgeArticle[]
  activities Activity[]

  @@index([name])
  @@index([sortOrder])
  @@index([deletedAt])
}

model KnowledgeArticle {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  excerpt String?
  content String

  status     KnowledgeArticleStatus     @default(DRAFT)
  visibility KnowledgeArticleVisibility @default(INTERNAL)
  featured   Boolean                    @default(false)
  sortOrder  Int                        @default(0)

  categoryId String
  authorId   String

  publishedAt DateTime?
  deletedAt   DateTime?

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  category KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author   User              @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([visibility])
  @@index([featured])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([sortOrder])
  @@index([status, visibility])
  @@index([categoryId, sortOrder])
  @@index([deletedAt, updatedAt])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeArticleVisibility {
  INTERNAL
  PUBLIC
}

enum PortfolioProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PortfolioProjectVisibility {
  INTERNAL
  PUBLIC
}

enum Role {
  USER
  ADMIN
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  TWITTER
  REFERRAL
  EMAIL
  COLD_OUTREACH
  GOOGLE
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  NOTE
  OTHER

  KNOWLEDGE_ARTICLE_CREATED
  KNOWLEDGE_ARTICLE_UPDATED
  KNOWLEDGE_ARTICLE_PUBLISHED
  KNOWLEDGE_ARTICLE_ARCHIVED
  KNOWLEDGE_ARTICLE_RESTORED
  KNOWLEDGE_ARTICLE_DELETED

  KNOWLEDGE_CATEGORY_CREATED
  KNOWLEDGE_CATEGORY_UPDATED
  KNOWLEDGE_CATEGORY_DELETED

  PORTFOLIO_PROJECT_CREATED
  PORTFOLIO_PROJECT_UPDATED
  PORTFOLIO_PROJECT_PUBLISHED
  PORTFOLIO_PROJECT_ARCHIVED
  PORTFOLIO_PROJECT_RESTORED
  PORTFOLIO_PROJECT_DELETED

  PORTFOLIO_CATEGORY_CREATED
  PORTFOLIO_CATEGORY_UPDATED
